# Em desenvolvimento o frontend corre com o mock de API em memória.
# Colocar VITE_USE_MOCK=false quando o backend real estiver disponível.
VITE_API_URL=/api
VITE_USE_MOCK=true

# Endereço do backend para o proxy de desenvolvimento (usado pelo Vite)
VITE_API_PROXY=http://localhost:3000

# Tamanho de página por omissão nas listagens
VITE_PAGE_SIZE=20

# Timeout das pedidos à API (ms)
VITE_API_TIMEOUT=15000